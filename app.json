{
  "expo": {
    "name": "Sudi Tenga Calculator",
    "slug": "sudi-tenga-calculator",
    "description": "Calculate monthly simple interest and total repayment for Chakma Sudi Tenga money lending, with local calculation history.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "suditengacalculator",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F19",
    "primaryColor": "#2563EB",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.edhot.suditengacalculator",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.edhot.suditengacalculator",
      "versionCode": 1,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Sudi Tenga Calculator",
      "shortName": "Sudi Tenga",
      "description": "Chakma monthly simple interest and total repayment calculator.",
      "lang": "en",
      "themeColor": "#0B0F19",
      "backgroundColor": "#0B0F19",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0F19",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "48dcf7c1-b76c-41b3-806a-1a0ddc28d5d7"
      }
    },
    "owner": "edhot",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/48dcf7c1-b76c-41b3-806a-1a0ddc28d5d7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
